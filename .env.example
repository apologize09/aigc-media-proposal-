# 复制为 .env 后在本地填写。不要提交 .env。
# 密钥和上传上限留空。空的上传限制表示拒绝上传，空的会话时长表示不按时间失效。

DATABASE_URL=
REDIS_URL=
AUTH_SECRET=
APP_BASE_URL=

# 仅本地种子首个管理员。库中已有账号时脚本会跳过。不要提交真实值。
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

AI_PROVIDER=volcengine-ark
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=doubao-seed-evolving
AI_ALLOW_ASSET_UPLOAD=
# 本地/CI 设为 1 使用夹具适配器，不访问真实方舟。生产保持空。
AI_USE_FIXTURE=

UPLOAD_MAX_BYTES=
UPLOAD_ALLOWED_MIME=
SHARE_DEFAULT_TTL_HOURS=
AUTH_SESSION_TTL_HOURS=
AUTH_LOCKOUT_THRESHOLD=
LOG_LEVEL=
TRUST_PROXY=
